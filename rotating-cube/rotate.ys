# rotate.ys - gira o objeto 45 graus por segundo nos eixos X e Y.
# Substitui a lógica que antes vivia no onUpdate() em C++ (src/main.cpp).

let speed = 1

function start:
    log("rotate.ys carregado")

function update dt:
    this.transform.position.x += speed * dt
    this.transform.position.y += speed * dt
